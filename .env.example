# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Auth (change in production!)
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=12h

# Database. Leave DATABASE_URL empty for the local file database (data/dev.sqlite, via sql.js).
# For PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/skillsup
DATABASE_URL=

# Uploaded files
UPLOAD_DIR=uploads

# Seed demo data when the database is empty (development only)
SEED_DEMO=true
LOGIN_RATE_LIMIT=10

# Cloudflare R2 file storage (leave all four empty to keep files in the local UPLOAD_DIR).
# Keep the keys SECRET: only in this .env (never committed) and in the hosting dashboard.

