# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000


# Database. Leave DATABASE_URL empty for the local file database (data/dev.sqlite, via sql.js).
# For PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/skillsup
# A REMOTE database (Neon...) is refused on a developer's computer unless ALLOW_REMOTE_DB=true: tests and experiments must not
# touch real data. On the hosting server (Render) it works as usual: set DATABASE_URL there, not in your local .env.
DATABASE_URL=

# Uploaded files
UPLOAD_DIR=uploads

# The administrator. The backend makes the database match these on every start (creates the admin, or replaces the
# password when it differs). Leave ADMIN_PASSWORD empty to leave the admin account alone. At least 8 characters.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Seed demo data when the database is empty (development only)
SEED_DEMO=true
LOGIN_RATE_LIMIT=10

# Cloudflare R2 file storage (leave all four empty to keep files in the local UPLOAD_DIR).
# Keep the keys SECRET: only in this .env (never committed) and in the hosting dashboard.

# Sign-in sessions last this many hours (a login creates a random token stored in the database)
SESSION_HOURS=12
